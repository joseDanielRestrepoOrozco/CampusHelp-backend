# Copia este archivo a `.env`.
# Los valores coinciden con el servicio `postgres` de docker-compose.yml.
# Si tu puerto 5432 está ocupado (por ejemplo, por un PostgreSQL instalado en Windows),
# publica el contenedor en otro puerto con un docker-compose.override.yml y cámbialo aquí.

# Conexión a PostgreSQL 15 o posterior.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sw3"

# Puerto de la API (por defecto 3000).
PORT=3000

# Orígenes del navegador permitidos, separados por comas. Vacío desactiva CORS.
ALLOWED_ORIGINS="http://localhost:5173"
